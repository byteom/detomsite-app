<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- READ_SMS ships with every release to bridge the old auto-forward
         path. The phone also needs android.permission.RECEIVE_SMS declared
         so it is treated as the default SMS handler for forwarding. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WhatsApp bot: polls the server in the background (foreground service),
         re-opens WhatsApp after a reboot, and needs "Display over other apps"
         so it may launch WhatsApp from the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Compile-time visibility of WhatsApp so we can detect it and open the
         conversation that carries our auto-sent message. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!--
      allowBackup=false: this app stores the ADMIN BEARER TOKEN in
      SharedPreferences. With backups on, that token is swept into Google Auto
      Backup and can be restored onto another device — a full admin credential
      leaving the phone without the admin ever seeing it. There is nothing here
      worth restoring, so backups are off entirely.
    -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              The old detomsite-agent://open deep link was removed: it was
              exported + BROWSABLE (so any app or web page could launch it) but
              NO code ever read the intent, so it was unused attack surface with
              a browser-reachable entry point and no benefit.
            -->
        </activity>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- WhatsApp bot: foreground poller that auto-opens WhatsApp with the
             order message pre-filled. -->
        <service
            android:name=".WhatsAppBotService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- WhatsApp bot: accessibility service that taps WhatsApp's Send
             button once we know the pre-filled message is on screen. -->
        <service
            android:name=".WhatsAppAccessibilityService"
            android:exported="false"
            android:label="@string/wa_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wa_accessibility_config" />
        </service>

        <!-- Restart the WhatsApp bot after the phone reboots. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>