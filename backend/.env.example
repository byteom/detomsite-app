# Backend environment variables
# Supabase Postgres is the only application database, including local development.
# Get the PostgreSQL URI from Supabase Dashboard -> Connect.
# Apply supabase/schema.sql and supabase/indexes.sql to that same project.
SEED_DEMO_DATA=False
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ...or use individual settings:
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
# Supabase project refs (used for optional profile sync + storage URLs).
# Get these from Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Demo seeding (keep False in production).
# SEED_DEMO_DATA is above; student domain lock: empty = any email allowed.
# STUDENT_EMAIL_DOMAINS=campus.edu,college.edu
STUDENT_EMAIL_DOMAINS=

# Read cache — optional, but this is what keeps the portals fast in production.
# Vercel's Upstash integration injects KV_REST_API_URL + KV_REST_API_TOKEN.
# Reads with no cache configured still work (they just hit Postgres every time).
# /health reports the active cache: {"cache":{"redis":{"transport":"rest"}}}
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or a plain Redis server (requires `pip install redis`):
# REDIS_URL=rediss://default:<password>@<host>:<port>
# REDIS_KEY_PREFIX=detomsite:
# Cache timeouts (defaults shown — uncomment to override).
# REDIS_TIMEOUT_SECONDS=1.5
# REDIS_BREAKER_FAILURES=5
# REDIS_BREAKER_COOLDOWN_SECONDS=30.0
# DB + cache budgets: a slow dependency must never pin a request.
# DB_STATEMENT_TIMEOUT_MS=20000
# CACHE_LOOKUP_TIMEOUT_SECONDS=0.2
# DB pool sizing (Render free + Supabase pooler: keep small).
# DB_POOL_MIN=5
# DB_POOL_MAX=10
# DB_IO_WORKERS=
# In-process Redis fallback (redislite). Leave unset = on when no REDIS_URL.
# Set 0 to keep it off (recommended when a real Redis is configured).
# DETOMSITE_EMBEDDED_REDIS=

# JWT
JWT_SECRET=replace-with-long-random-secret
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Super Admin
DEFAULT_SUPER_ADMIN_EMAIL=12@gmail.com
DEFAULT_SUPER_ADMIN_PASSWORD=8989

# Frontend / Supabase (used by the frontends for optional profile sync)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary — primary image storage (payment screenshots). Secrets stay server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder prefix for uploads (default "detomsite").
# CLOUDINARY_FOLDER_PREFIX=detomsite
# Payment screenshot size cap in MB (default 5).
# PAYMENT_SCREENSHOT_MAX_MB=5

# Telegram admin notifications — bot token + admin chat stay server-side.
# 1. Talk to @BotFather on Telegram → /newbot → copy the token below.
# 2. Message your bot once from the admin's Telegram account.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates → copy the chat "id".
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# "VIEW ORDER" button target: split admin portal if set, else FRONTEND_URL +
# ADMIN_ORDER_PATH (legacy portal default /admin/orders/<orderId>).
# ADMIN_PORTAL_URL=https://<your-admin-portal>.vercel.app
# ADMIN_ORDER_PATH=/admin/orders
# Inbound bot commands (/start, /help, /status) via Telegram webhook.
# 1. Deploy the backend, then register (replace BACKEND_URL + generate a secret):
#    https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BACKEND_URL>/api/v1/local/telegram/webhook&secret_token=<RANDOM_LONG_STRING>
# 2. Put the same secret here so forged updates are refused:
# TELEGRAM_WEBHOOK_SECRET=
# Without the secret, the webhook still answers but accepts any caller.

# SMS-forwarder agent auth. The Android app posts bank credit SMS to
# `/sms/incoming` with this key — a stranger can't feed fake credits without it.
SMS_FORWARD_KEY=
# Only True if your own trusted proxy rewrites x-forwarded-for as a single hop.
# Vercel/Render append the real client IP, so keep False on both.
TRUST_PROXY_HEADERS=False

# WhatsApp automatic delivery (optional). Provider: wassenger | meta | webhook.
WA_PROVIDER=
WA_API_TOKEN=
WA_API_URL=
WA_META_TOKEN=
WA_META_PHONE_ID=

# Web Push (VAPID) — order notifications for the installed vendor app.
# Generate keys with: python backend/scripts/gen_vapid.py
# Empty = backend auto-generates local vapid_keys.json (dev only).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@detomsite.local

# Razorpay — CUT OFF (gateway endpoints answer 410). Keys kept for reference only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── SMTP (forgot-password OTP email — REQUIRED for password recovery) ───
# Gmail default: host=smtp.gmail.com, port=587, STARTTLS on.
# Password = Google Account → Security → 2-Step Verification → App passwords
# (16 chars — paste without spaces). Port 465 = implicit SSL (set SMTP_USE_TLS=false).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=DETOMSITE <you@gmail.com>
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
# OTP validity window
RESET_OTP_EXPIRE_MINUTES=15
# Alternative to SMTP (either one delivers; SMTP is tried first):
# RESEND_API_KEY=
# RESEND_FROM=DETOMSITE <onboarding@resend.dev>

# Sentry
SENTRY_DSN=

# Application
APP_NAME=DETOMSITE
APP_VERSION=3.1.0
DEBUG=True  # True = local development (allows localhost URLs); set False when deploying
HOST=0.0.0.0
PORT=8000
# FRONTEND_URL = your MAIN portal URL (single value). Local dev: localhost OK when DEBUG=True.
# Production: https://your-user-portal.vercel.app
FRONTEND_URL=http://localhost:5173
# BACKEND_URL = your backend API URL. Production: https://your-api.vercel.app
BACKEND_URL=http://localhost:8000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,https://your-frontend.vercel.app,https://your-backend.vercel.app

# ─── Render operations (backend on Render, portals on Vercel) ───
# HEALTH_URL = what the keep-alive pings. cron-job.org hits this every 3 min
# so Render free never sleeps. Falls back to BACKEND_URL when empty.
HEALTH_URL=
# Split admin portal base for the Telegram "VIEW ORDER" button.
# Empty = FRONTEND_URL + ADMIN_ORDER_PATH is used.
ADMIN_PORTAL_URL=
